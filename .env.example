# Copiar a .env. Sustituir el marcador antes del primer arranque.
POSTGRES_USER=tyto
POSTGRES_PASSWORD=REPLACE_WITH_A_RANDOM_PASSWORD
POSTGRES_DB=tyto
POSTGRES_PORT=5432
STP_PORT=8000
DASHBOARD_PORT=8080
DESTINATION_SLUG=cueva-lechuzas
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:8080","http://localhost:5173"]
SMS_BASE_URL=http://sms:8001
WEATHER_CACHE_TTL_SECONDS=10800
WEATHER_TIMEOUT_SECONDS=10
OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast
VITE_API_BASE_URL=http://localhost:8000
# Para ejecutar STP o scripts fuera de Docker, definir una URL con contraseña codificada.
# DATABASE_URL=postgresql+asyncpg://tyto:URL_ENCODED_PASSWORD@localhost:5432/tyto
# TEST_DATABASE_URL=postgresql+asyncpg://tyto:URL_ENCODED_PASSWORD@localhost:55432/tyto_test

